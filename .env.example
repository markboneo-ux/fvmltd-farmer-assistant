# ---------------------------------------------------------------------------
# Supabase — copy to .env.local for local development
# Also add these in the Vercel project settings (see README).
# ---------------------------------------------------------------------------

# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable anon / public key (safe for browser / Client Components)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Never commit the real value. Never import into Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# OpenAI — SERVER ONLY. Used for preliminary crop assessments.
# Never prefix with NEXT_PUBLIC_. Never import into Client Components.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key

# Optional model override (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Weather — provider-independent forecast (server only)
# ---------------------------------------------------------------------------
# open-meteo (default, no key) | mock (tests)
WEATHER_PROVIDER=open-meteo

# Relative humidity % treated as humid for leaf-wetness estimation
WEATHER_HUMID_RH_THRESHOLD=85

# ---------------------------------------------------------------------------
# Public website / app URLs — no vercel.app hardcoding
# ---------------------------------------------------------------------------
# Canonical origin of this app after the custom domain is attached
NEXT_PUBLIC_APP_URL=https://crop.farmersvaluemart.com

# Farmersvaluemart company site (header return link)
NEXT_PUBLIC_MAIN_WEBSITE_URL=https://farmersvaluemart.com

# Optional when the app is mounted at /crop-solution instead of a subdomain
# NEXT_PUBLIC_BASE_PATH=/crop-solution

# ---------------------------------------------------------------------------
# Controlled-beta usage limits (server-side; do not copy into client code)
# ---------------------------------------------------------------------------
FVM_GUEST_MAX_MESSAGES=20
FVM_GUEST_MAX_CASES=3
FVM_GUEST_MAX_IMAGE_ANALYSES=6
FVM_REGISTERED_FREE_MESSAGES=80
FVM_REGISTERED_FREE_CASES=10
FVM_REGISTERED_FREE_IMAGES=24

# Conversational case storage. Production with Supabase configured always uses
# supabase and ignores memory. Local tests default to memory.
# CASE_PERSISTENCE=memory
# CASE_PERSISTENCE=supabase

# Optional web search for current prices, registrations, and government pages.
# If unset, research still fetches trusted source URLs directly (NAMDEVCO, ministries).
# TAVILY_API_KEY=your-tavily-key
# WEB_SEARCH_API_KEY=your-tavily-or-compatible-key
