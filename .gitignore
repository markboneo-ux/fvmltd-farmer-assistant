# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example committed as a template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor / native
/android/.gradle
/android/app/build
/android/build
/android/local.properties
/android/captures
/android/.idea
/ios/App/Pods
/ios/App/App/public
/ios/DerivedData
*.xcuserstate
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata
*.keystore
*.jks
